<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="obj/CoreVersion.props" Condition="Exists('obj/CoreVersion.props')" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ContextOS.Windows</AssemblyName>
    <RootNamespace>ContextOS.Windows</RootNamespace>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="obj/CoreContract.json" LogicalName="ContextOS.CoreContract.json" />
  </ItemGroup>
  <Target Name="RequireSharedCoreContract" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('obj/CoreVersion.props') Or !Exists('obj/CoreContract.json')"
           Text="Run scripts/prepare_windows_gui.py with a verified Swift contract before building the GUI." />
  </Target>
</Project>
